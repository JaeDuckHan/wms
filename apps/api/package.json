{
  "name": "wms-api",
  "version": "1.0.0",
  "description": "Minimal WMS API server with MySQL connectivity",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "node -e \"require('./src/server'); console.log('build-ok')\"",
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "env:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check_env.ps1",
    "install:local": "powershell -ExecutionPolicy Bypass -File ./scripts/install_local.ps1",
    "seed:billing-demo": "node scripts/seed_billing_demo.js",
    "seed:flow-test": "node scripts/seed_flow_test_data.js",
    "seed:menu-test": "node scripts/seed_menu_test_data.js",
    "seed:scenario:integrated": "node scripts/seed_integrated_random_scenario.js",
    "test:e2e:settlement": "powershell -ExecutionPolicy Bypass -File ./scripts/run_settlement_invoice_flow.ps1",
    "test:e2e:reopen-reject": "powershell -ExecutionPolicy Bypass -File ./scripts/run_settlement_reopen_reject_flow.ps1",
    "test:e2e:invoice-reuse": "powershell -ExecutionPolicy Bypass -File ./scripts/run_invoice_reuse_flow.ps1",
    "test:e2e:insufficient-stock": "powershell -ExecutionPolicy Bypass -File ./scripts/run_outbound_insufficient_stock.ps1",
    "test:e2e:outbound-detail": "powershell -ExecutionPolicy Bypass -File ./scripts/run_outbound_detail_flow.ps1",
    "test:e2e:inventory-flow": "node scripts/e2e_inventory_flow.js",
    "test:e2e:inbound-detail": "powershell -ExecutionPolicy Bypass -File ./scripts/run_inbound_detail_flow.ps1",
    "test:contracts:operational": "node scripts/check_operational_contracts.js",
    "test:e2e:billing-production": "powershell -ExecutionPolicy Bypass -File ./scripts/run_billing_production_flow.ps1",
    "test:e2e:health-smoke": "node ./scripts/e2e_health_smoke.js",
    "test:invoice-export": "node scripts/test_invoice_export_contract.js",
    "test:invoice-pdf-font": "node scripts/test_invoice_pdf_font_contract.js",
    "test:invoice-thb": "node scripts/test_invoice_thb_contract.js",
    "seed:phase1-integrated": "node scripts/seed_phase1_integrated.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.3",
    "pdfkit": "^0.18.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
